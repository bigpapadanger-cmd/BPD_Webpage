{
  "name": "domaindata",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "cache:ids": "node public/scripts/generate-cache-ids.js",
    "build": "npm run routes:generate && npm run cache:ids && npm run assets:build && wrangler pages functions build functions --outdir=.wrangler/pages-build",
    "build:check": "npm run routes:generate && npm run assets:build && wrangler pages functions build functions --outdir=.wrangler/pages-build",
    "check:frontend": "npm run build:check && npm run test:routes",
    "assets:build": "node scripts/build-public-assets.mjs",
    "dev": "npm run cache:ids && wrangler pages dev public",
    "test": "npm run build:check && npm run test:ocr && npm run test:rocketleague && npm run test:suggestions && npm run test:notifications && npm run test:routes && npm run test:admin && npm run test:workers",
    "test:ocr": "node --test tests/ocr/*.test.mjs",
    "test:rocketleague": "node --test tests/rocketleague/*.test.mjs",
    "test:suggestions": "node --test tests/suggestions/*.test.mjs",
    "test:notifications": "node --test tests/notifications/*.test.mjs",
    "test:routes": "npm run routes:generate && node --test tests/route_health/*.test.mjs",
    "test:admin": "node --test tests/admin/*.test.mjs",
    "test:workers": "npm run test:google-mtls-diagnostic && node --test workers/bpd-custom-match-runtime/tests/*.test.mjs workers/bpd-discord-communications/tests/*.test.mjs workers/bpd-provider-runtime/tests/*.test.mjs workers/ocr-cloud-run-proxy/tests/*.test.mjs workers/rl-presence-monitor/tests/worker_dispatch.test.mjs workers/ocr-job-consumer/tests/*.test.mjs",
    "test:bpd-provider-runtime": "node --test workers/bpd-provider-runtime/tests/*.test.mjs",
    "test:google-mtls-diagnostic": "node --test workers/google-mtls-diagnostic/tests/*.test.mjs",
    "routes:generate": "node scripts/generate-api-route-inventory.mjs",
    "wrangler:check": "npm outdated wrangler || exit 0",
    "wrangler:update": "npm install --save-dev wrangler@latest",
    "wrangler:version": "wrangler --version"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "^4.143.0"
  }
}
