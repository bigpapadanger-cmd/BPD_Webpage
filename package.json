{
    "name": "domaindata",
    "version": "1.1.2",
    "private": true,
    "type": "module",
    "scripts": {
        "cache:ids": "node scripts/generate-cache-ids.js",
        "build": "npm run cache:ids && wrangler pages functions build functions --outdir=.wrangler/pages-build",
        "build:check": "wrangler pages functions build functions --outdir=.wrangler/pages-build",
        "dev": "npm run cache:ids && wrangler pages dev",
        "test": "npm run build:check"
    },
    "devDependencies": {
        "wrangler": "^4"
    }
}