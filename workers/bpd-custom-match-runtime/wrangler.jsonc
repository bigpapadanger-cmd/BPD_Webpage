{
  "name": "bpd-custom-match-runtime",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "vars": {
    "CUSTOM_MATCH_RUNTIME_ENABLED": "true",
    "SUPABASE_URL": "https://xslrwamnfqgoziaczgsn.supabase.co/rest/v1/"
  },
  "durable_objects": { "bindings": [{ "name": "CUSTOM_MATCH_SESSIONS", "class_name": "CustomMatchSession" }] },
  "migrations": [{ "tag": "custom-match-session-v1", "new_sqlite_classes": ["CustomMatchSession"] }],
  "observability": { "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": true } }
}
