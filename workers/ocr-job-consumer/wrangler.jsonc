{
    "name": "bpd-ocr-job-consumer",

    "main": "src/index.js",

    "compatibility_date": "2026-09-01",
    "workers_dev": false,
    "preview_urls": false,
    "queues": {
        "consumers": [
            {
                "queue": "bpd-ocr-jobs",
                "max_batch_size": 1,
                "max_batch_timeout": 1,
                "max_retries": 2,
                "max_concurrency": 2
            }
        ]
    },

    "triggers": {
        "crons": [
            "*/15 * * * *"
        ]
    },

    "vars": {

        "OCR_API_URL": "https://bpd-ocr-y5wgeempka-uc.a.run.app/api/ocr",
        "OCR_JOB_PROCESS_URL": "https://bpd-gaming-network.com/api/ocr/jobs/process_job",
        "OCR_JOB_PROGRESS_URL": "https://bpd-gaming-network.com/api/ocr/jobs/progress",
        "OCR_DEBUG_TRACE_ENABLED":"true"
    },

    "r2_buckets": [
        {
            "binding": "OCR_STORAGE",
            "bucket_name": "ocr-storage"
        }
    ],
    "observability": {
            "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
            },
            "traces": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true
            }
        }
    
}