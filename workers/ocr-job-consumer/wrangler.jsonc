{
    "name": "bpd-ocr-job-consumer",
    "main": "src/index.js",
    "compatibility_date": "2026-09-18",

    "workers_dev": false,
    "preview_urls": false,
  "placement": {
    "mode": "smart"
  },

    "routes": [
        {
            "pattern": "ocr.bpd-gaming-network.com",
            "custom_domain": true
        }
    ],

    "queues": {
        "consumers": [
            {
                "queue": "bpd-ocr-jobs",
                "max_batch_size": 1,
                "max_batch_timeout": 1,
                "max_retries": 2,
                "max_concurrency": 2
            }
        ]
    },

    "triggers": {
        "crons": [
            "*/30 * * * *"
        ]
    },
    "vars": {
        "OCR_JOB_PROCESS_URL": "https://bpd-gaming-network.com/api/ocr/jobs/process_job",
        "OCR_DEBUG_TRACE_ENABLED": "true"
    },

    "r2_buckets": [
        {
            "binding": "OCR_STORAGE",
            "bucket_name": "ocr-storage"
        },
        {
            "binding": "OCR_PROGRESS",
            "bucket_name": "ocr-progress"
        }
    ],

    "kv_namespaces": [
        {
            "binding": "SERVICE_STATUS",
            "id": "b01a6271a3fd47e7831bcb2502a0b901"
        }
    ],

    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true
        }
    }
}
