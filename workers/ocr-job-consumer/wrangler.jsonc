{
    "name": "bpd-ocr-job-consumer",

    "main": "src/index.js",

    "compatibility_date": "2026-09-01",

    "queues": {
        "consumers": [
            {
                "queue": "bpd-ocr-jobs",
                "max_batch_size": 1,
                "max_batch_timeout": 1,
                "max_retries": 2,
                "max_concurrency": 2
            }
        ]
    },

    "triggers": {
        "crons": [
            "*/15 * * * *"
        ]
    },

    "vars": {
        "OCR_JOB_PROCESS_URL":"https://bpd-gaming-network.com/api/ocr/jobs/process_job",

        "OCR_DEBUG_TRACE_ENABLED":"true"
    },

    "r2_buckets": [
        {
            "binding": "OCR_STORAGE",
            "bucket_name": "ocr-storage"
        }
    ]
}