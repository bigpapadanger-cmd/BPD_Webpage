{
  "name": "bpd-rl-presence-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "status.bpd-gaming-network.com",
      "custom_domain": true
    }
  ],

  "triggers": {
    "crons": [
      "*/15 * * * *",
      "5 11 * * SAT"
    ]
  },

  "vars": {
    "SUPABASE_URL": "https://xslrwamnfqgoziaczgsn.supabase.co/rest/v1/",
    "MMR_API_URL": "https://mmr.bpd-gaming-network.com"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}