{
  "name": "bpd-provider-runtime-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "DISCORD_LARGE_BOT_SHARDING": "false",
    "RL_PROBE_SECURITY_ENABLED": "false",
    "RL_PROBE_ISSUER": "bpd-provider-runtime-staging",
    "RL_PROBE_KEY_VERSION": "staging-v1"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RL_USER_SESSION", "class_name": "UserRocketLeagueSession" },
      { "name": "RL_PROBE_SECURITY", "class_name": "RlProbeSecurityAuthority" },
      { "name": "DISCORD_LINKED_ROLE_NONCE", "class_name": "DiscordLinkedRoleNonceAuthority" }
    ]
  },
  "migrations": [
    { "tag": "rl-probe-security-v1", "new_sqlite_classes": ["UserRocketLeagueSession"] },
    { "tag": "rl-probe-authority-v2", "new_sqlite_classes": ["RlProbeSecurityAuthority"] },
    { "tag": "discord-linked-role-nonce-v1", "new_sqlite_classes": ["DiscordLinkedRoleNonceAuthority"] }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    }
  }
}
