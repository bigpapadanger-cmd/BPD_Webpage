    "r2_buckets": [
        {
            "binding": "OCR_TRAINING",
            "bucket_name": "ocr-training"
        },
        {
            "binding": "OCR_STORAGE",
            "bucket_name": "ocr-storage"
        },
        {
            "binding": "OCR_PROGRESS",
            "bucket_name": "ocr-progress"
        }
    ],

    "queues": {
        "producers": [
            {
                "queue": "bpd-ocr-jobs",
                "binding": "OCR_JOB_QUEUE"
            }
        ]
    }
}