{
    "name": "bpd-gaming-network",

    "compatibility_date": "2026-09-16",

    "pages_build_output_dir": "./public",

    "kv_namespaces": [
        {
            "binding": "AUTH_SESSIONS",
            "id": "941c19ab958e498a9846b80cfd3f6525"
        }
    ],

    "vars": {
        "OCR_API_URL": "https://bpd-ocr-y5wgeempka-uc.a.run.app/api/ocr",
        "OCR_JOB_PROCESS_URL": "https://bpd-gaming-network.com/api/ocr/jobs/process_job",
        "OCR_JOB_PROGRESS_URL": "https://bpd-gaming-network.com/api/ocr/jobs/progress",
        "SUPABASE_URL": "https://xslrwamnfqgoziaczgsn.supabase.co/rest/v1/",
        "SB_CALLBACK_URL":"https://xslrwamnfqgoziaczgsn.supabase.co/auth/v1/callback",
        "DISCORD_AUTHZ_ADMIN_ROLE_ID": "1548306582226468985",
        "DISCORD_AUTHZ_MOD_ROLE_ID": "1548306818491613235",
        "DISCORD_AUTHZ_LEAGUE_STAFF_ROLE_ID":"1548306980035235871",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAExY7tl-k005rJaK",
        "SB_PUB_KEY":"sb_publishable_pC27tz0RVXuqe4Zfna3lpA_m7ZWc_pb",
        "DISCORD_MATCHBOT_INSTALL_URL":"https://discord.com/oauth2/authorize?client_id=1549606323249877034",
        "DISCORD_MATCHBOT_PUBLIC_KEY":"6a1a6c317812b984de29ed9dc09c3dc9d5e83c81accd5e710a7d68737f666097",
        "MMR_API_URL":"https://mmr.bpd-gaming-network.com",
        "RL_PRESENCE_MONITOR_URL":"https://status.bpd-gaming-network.com"
