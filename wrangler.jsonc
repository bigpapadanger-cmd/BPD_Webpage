{
    "name": "bpd-gaming-network",

    "compatibility_date": "2026-09-01",

    "compatibility_flags": [
        "formdata_parser_supports_files"
    ],

    "pages_build_output_dir": "./public",

    "kv_namespaces": [
        {
            "binding": "AUTH_SESSIONS",
            "id": "941c19ab958e498a9846b80cfd3f6525"
        }
    ],

    "vars": {
        "OCR_API_URL": "https://bpd-ocr-y5wgeempka-uc.a.run.app"
    },

    "r2_buckets": [
        {
            "binding": "OCR_TRAINING",
            "bucket_name": "ocr-training"
        },
        {
            "binding": "OCR_STORAGE",
            "bucket_name": "ocr-storage"
        }
    ]
}