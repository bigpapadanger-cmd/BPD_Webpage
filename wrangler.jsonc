{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "bpd-gaming-network",
    "main": "src/index.js",
    "compatibility_date": "2026-08-19",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/auth/*",
            "/api/auth/*",
            "/api/ocr",
            "/api/ocr/*",
            "/api/rocketleague/*"
        ]
    },
	"vars": {
		"OCR_SERVICE_URL": "https://bpd-ocr-586465851833.us-central1.run.app",
		"EPIC_CLIENT_ID": "xyza7891aZB85NEmCtQMKYzi3sCIVMHG",
		"EPIC_DEPLOYMENT_ID": "32c6fb9064f54583a2270253fd0cd2fa",
		"EPIC_REDIRECT_URI": "https://bpd-gaming-network.com/auth/epic/callback"
	},
	"kv_namespaces": [
		{
			"binding": "AUTH_SESSIONS",
			"id": "941c19ab958e498a9846b80cfd3f6525"
		}
	],
    "secrets": {
        "required": [
            "OCR_API_KEY",
            "EPIC_CLIENT_SECRET"
        ]
    }
}